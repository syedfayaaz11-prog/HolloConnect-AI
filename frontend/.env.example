NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In — must be the *same* OAuth Client ID as the backend's GOOGLE_CLIENT_ID (see
# backend/.env.example). This one is safe to expose to the browser (OAuth client IDs are
# public by design; the corresponding secret, if any, never lives here). Leave blank to hide
# the "Continue with Google" button entirely — email/password sign-in works exactly as before
# either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
