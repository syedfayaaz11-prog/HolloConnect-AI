DATABASE_URL="postgresql://user:password@localhost:5432/holloconnect"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Signs the expiring URLs used to serve private uploaded/generated files (see
# src/utils/signedFileUrl.ts) — separate from JWT_SECRET on purpose, so the two signing
# domains never share key material. Optional: falls back to a key derived from JWT_SECRET if
# unset, but set this explicitly in production.
FILE_SIGNING_SECRET="replace-with-a-second-long-random-secret"

# Encrypts user-supplied BYOK API keys at rest (AES-256-GCM) — see
# src/services/apiKeys.service.ts. Separate from JWT_SECRET/FILE_SIGNING_SECRET on purpose,
# same reasoning as those: the three signing/encryption domains shouldn't share key material.
# Optional: falls back to a key derived from JWT_SECRET if unset, but set this explicitly in
# production — if it's ever unset for a stretch and someone sets it later, any keys encrypted
# under the old (derived) key won't decrypt anymore.
API_KEY_ENCRYPTION_SECRET="replace-with-a-third-long-random-secret"

# Google Sign-In — the OAuth 2.0 Client ID from Google Cloud Console (APIs & Services ->
# Credentials -> OAuth client ID -> Web application). The frontend needs the *same* value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (see frontend/.env.example) — it's not a secret (client IDs are
# public by design), but both sides must agree on it or token verification will reject every
# sign-in. Leave blank to disable the "Continue with Google" button/endpoint entirely —
# existing email/password auth is completely unaffected either way.
GOOGLE_CLIENT_ID=""

# Set to "true" only if this server sits behind a reverse proxy / load balancer that sets
# X-Forwarded-For itself (e.g. Nginx, a cloud load balancer, Vercel/Render/Fly's edge). This
# controls whether rate limiting trusts that header for the real client IP — enabling it
# without an actual trusted proxy in front lets any client spoof their IP and dodge limits.
TRUST_PROXY="false"

# AI providers — add keys for whichever models you want to enable.
# The provider abstraction in src/services/ai.service.ts only needs a
# new case added when you add a new provider; no other code changes.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY="" # native api.deepseek.com
MISTRAL_API_KEY=""  # native api.mistral.ai
XAI_API_KEY=""      # native api.x.ai (Grok)

# Generic OpenAI-compatible endpoint for aggregators/custom hosts without a dedicated provider
# above — OpenRouter, Groq-hosted Llama/Qwen, Together AI, self-hosted, etc.
# e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""

# Web search (used by AI Search and Deep Research modules) — get a key at tavily.com
TAVILY_API_KEY=""

# Video generation (Replicate) — get a token at replicate.com, and a model version hash
# from whichever text/image-to-video model you want (e.g. a Stable Video Diffusion variant).
REPLICATE_API_TOKEN=""
REPLICATE_VIDEO_MODEL_VERSION=""

# Publicly reachable URL for this backend, required only for image-to-video (the provider
# must be able to fetch your uploaded source image over the internet). Leave blank while
# developing locally with text-to-video only.
PUBLIC_BACKEND_URL=""

# Voice AI: STT + default TTS use OPENAI_API_KEY (already set above). ElevenLabs is an
# optional second TTS provider for higher-quality/custom voices.
ELEVENLABS_API_KEY=""
# Comma-separated "voiceId:Label" pairs from your ElevenLabs account, e.g.:
# ELEVENLABS_VOICE_IDS="21m00Tcm4TlvDq8ikWAM:Rachel,AZnzlk1XvdvUeBnXmlld:Domi"
ELEVENLABS_VOICE_IDS=""

# OCR: default provider is OpenAI Vision (reuses OPENAI_API_KEY above, no extra setup).
# Set OCR_PROVIDER=google-vision to use Google Cloud Vision instead (needs its own key).
OCR_PROVIDER="openai-vision"
GOOGLE_VISION_API_KEY=""
